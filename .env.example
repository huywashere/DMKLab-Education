# ==============================================================================
# DMKLab Education Platform - Environment Configuration Template
# ==============================================================================
# HƯỚNG DẪN: Copy file này thành file `.env` và điền thông tin thực tế.

# ------------------------------------------------------------------------------
# 1. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible, 0đ Phí Băng Thông Egress)
# ------------------------------------------------------------------------------
# Chọn nhà cung cấp: 'r2' (Cloudflare R2 Khuyên dùng) hoặc 'minio' / 's3'
STORAGE_PROVIDER=r2

# Account ID của Cloudflare (Xem tại Dashboard Cloudflare -> R2 Overview)
# Định dạng: chuỗi hash 32 ký tự, ví dụ: 8ab295e87a2c019d45e543666d9b4b0e
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# Tên Bucket lưu trữ video bài giảng K-12, hình ảnh và tài liệu
R2_BUCKET=education-media

# R2 API Token: Vào Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> "Create API Token"
# Chọn quyền: "Object Read & Write", TTL: Không thời hạn
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Tên miền CDN công khai (Custom Domain kết nối vào R2 Bucket hoặc URL r2.dev)
# Ví dụ: https://media.dmklab.edu.vn hoặc https://pub-xxxxxx.r2.dev
R2_PUBLIC_URL=https://media.dmklab.edu.vn

# Thời gian hiệu lực của Presigned Upload URL (giây, mặc định 900s = 15 phút)
R2_PRESIGNED_EXPIRY=900

# ------------------------------------------------------------------------------
# 2. HẠ TẦNG CƠ SỞ DỮ LIỆU & CACHE (POSTGRESQL & REDIS)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=learning_db
DB_USER=postgres
DB_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. MINIO LOCAL S3 (Dùng khi chạy offline chưa có tài khoản Cloudflare)
# ------------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=education-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ------------------------------------------------------------------------------
# 4. BẢO MẬT XÁC THỰC JWT & TRÍ TUỆ NHÂN TẠO SOCRATIC AI (GROQ / GEMINI / OPENAI)
# ------------------------------------------------------------------------------
JWT_SECRET=KhanAcademySecureJWTSecretKeyWithHighEntropy2026SuperStrongHMACSHA512KeyDMKLabPlatform

# Chọn nhà cung cấp ưu tiên: 'groq' (siêu tốc, free), 'gemini' (hào phóng, free), hoặc 'openai'
AI_PROVIDER=gemini

# Groq Cloud API (LPU Inference siêu tốc, miễn phí quota hàng ngày: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini API (Free tier vĩnh viễn 1500 req/ngày: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI ChatGPT API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. EMAIL GATEWAY (RESEND / SMTP / CONSOLE SANDBOX)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=DMKLab Education <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. INCIDENT MONITORING & ALERTMANAGER (TELEGRAM / DISCORD / SLACK WEBHOOK)
# ------------------------------------------------------------------------------
ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
