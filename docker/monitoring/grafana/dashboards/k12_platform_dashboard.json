      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 6 },
      "id": 8,
      "title": "API Request Throughput by HTTP Status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (status)",
          "legendFormat": "Status {{status}}",
          "refId": "A"
        }
