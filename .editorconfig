# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Default rules for all files
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Java source code (Spring Boot backend)
[*.java]
indent_size = 4
indent_style = space
max_line_length = 120

# XML and Maven POM configuration
[*.xml]
indent_size = 4
indent_style = space

# TypeScript, JavaScript and React files
[*.{js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2
indent_style = space
max_line_length = 100

# Stylesheets (CSS, SCSS)
[*.{css,scss,less}]
indent_size = 2
indent_style = space

# JSON, YAML and configuration files
[*.{json,yaml,yml}]
indent_size = 2
indent_style = space

# Markdown files
[*.{md,markdown}]
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts and batch files
[*.sh]
end_of_line = lf
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Dockerfile and Makefiles
[{Dockerfile,Makefile}]
indent_style = tab
