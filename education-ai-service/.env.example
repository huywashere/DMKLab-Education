# ==========================================
# DMKLab AI Service - Environment Variables
# ==========================================

# Server
PORT=8000
DEBUG=false

# Database (same PostgreSQL as Java backend)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learning_db

# Redis (same Redis as Java backend)
REDIS_URL=redis://localhost:6379/0

# AI Provider Priority: gemini | groq | openai
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud (LPU - ultra fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI Compatible
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# JWT Secret (Khớp với Java backend để verify token tự động)
JWT_SECRET=KhanAcademySecureJWTSecretKeyWithHighEntropy2026SuperStrongHMACSHA512KeyDMKLabPlatform

# Quota học sinh (30 câu hỏi / ngày)
STUDENT_DAILY_QUOTA=30

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
