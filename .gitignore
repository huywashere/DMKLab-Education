# ==============================================================================
# DMKLab Education Platform - Git Ignore Rules
# ==============================================================================

# AI Agents & Assistants Workspace
.agents/
.claude/
.cursor/
.gemini/

# IDEs & Editors
.vscode/
.idea/
*.iml
*.ipr
*.iws

# Java Maven Build Artifacts
**/target/
*.class
*.jar
*.war
*.ear

# Node / Next.js / PNPM
**/node_modules/
**/.next/
**/out/
**/build/
*.tsbuildinfo
next-env.d.ts
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Go Binaries & Transcoder Temp
*.exe
*.exe~
*.dll
*.so
*.dylib
temp_transcode/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
[Nn]et[Hh]ood
[Tt]rash-*
Desktop.ini

# Environment Variables & Secrets (Bảo vệ thông tin đăng nhập và API keys)
.env
.env*.local
*.env
!.env.example
!.env.production.example
!education-frontend/.env.example

# Temporary / Scratch / Backups / Certificates
temp/
tmp/
scratch/
*.log
*.tmp
*.bak
*.swp
*.swo
*.pem
*.crt
*.key
*.sql.gz
