# ==============================================================================
# DMKLab Education Platform - PRODUCTION Environment Configuration (.env)
# ==============================================================================
# HƯỚNG DẪN: Copy file này thành `.env` trên VPS của bạn và chỉnh sửa tên miền.
# Chạy lệnh: cp .env.production.example .env && nano .env

# ------------------------------------------------------------------------------
# 1. CẤU HÌNH TÊN MIỀN & CHỨNG CHỈ SSL LET'S ENCRYPT
# ------------------------------------------------------------------------------
# Tên miền chính của hệ thống (ví dụ: dmklab.edu.vn hoặc hocmai.vn)
DOMAIN_NAME=dmklab.edu.vn

# Email dùng để đăng ký chứng chỉ SSL miễn phí Let's Encrypt (nhận cảnh báo gia hạn)
LETSENCRYPT_EMAIL=admin@dmklab.edu.vn

# ------------------------------------------------------------------------------
# 2. CƠ SỞ DỮ LIỆU POSTGRESQL & REDIS (BẢO VỆ NỘI BỘ, ZERO-EXPOSE INTERNET)
# ------------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=learning_db
DB_USER=postgres
# Hãy đổi mật khẩu DB mạnh cho môi trường sản xuất
DB_PASSWORD=dmklab_production_strong_password_2026_postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 OBJECT STORAGE (S3-Compatible, 0đ Phí Băng Thông Egress)
# ------------------------------------------------------------------------------
# Chọn nhà cung cấp: 'r2' (Khuyên dùng cho sản xuất) hoặc 'minio' (khi chạy local)
STORAGE_PROVIDER=r2

# Account ID của Cloudflare (Xem tại Dashboard Cloudflare -> R2 Overview, hash 32 ký tự)
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# Tên Bucket lưu trữ video bài giảng K-12, hình ảnh và tài liệu
R2_BUCKET=education-media

# R2 API Token: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> "Create API Token"
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Tên miền CDN công khai (Custom Domain trỏ vào R2 Bucket hoặc URL r2.dev)
R2_PUBLIC_URL=https://media.dmklab.edu.vn

# Thời gian hiệu lực của Presigned Upload URL (giây, mặc định 900s = 15 phút)
R2_PRESIGNED_EXPIRY=900

# ------------------------------------------------------------------------------
# 4. BẢO MẬT XÁC THỰC JWT & TRÍ TUỆ NHÂN TẠO SOCRATIC AI
# ------------------------------------------------------------------------------
# Chuỗi khóa bí mật JWT HMAC-SHA512 tối thiểu 64 ký tự
JWT_SECRET=DMKLabProductionSecretKeyMustBeVeryLongAndHighEntropy2026SuperSecureTokenKeyEducation

# Chọn nhà cung cấp AI ưu tiên: 'gemini' (Free 1500 req/ngày), 'groq' (siêu tốc), hoặc 'openai'
AI_PROVIDER=gemini

# Google Gemini API Key (Lấy tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud API Key (LPU siêu tốc, miễn phí: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI ChatGPT API Key (nếu muốn dùng GPT-4o-mini: https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. EMAIL GATEWAY (GỬI THƯ KÍCH HOẠT TÀI KHOẢN & BÁO CÁO PHỤ HUYNH)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM=DMKLab Education <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 6. GIÁM SÁT & QUẢN TRỊ (GRAFANA & ALERTMANAGER)
# ------------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=DMKLabMonitor@Admin2026

# Webhook thông báo sự cố (Discord, Telegram bot, hoặc Slack)
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
